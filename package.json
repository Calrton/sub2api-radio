{
  "name": "sub2api-radio",
  "version": "0.1.0",
  "description": "A drop-in ambient radio player for AI consoles.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src/components",
    "src/lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/components/Sub2ApiRadio.vue",
    "./shuffle": "./src/lib/shuffle.ts",
    "./types": "./src/lib/types.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:audio": "node scripts/generate-sample.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
